<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Don hang da bi huy</title>
  </head>
  <body
    style='margin:0;padding:0;background-color:#faf9f2;font-family:Arial,Helvetica,sans-serif;color:#182233;'
  >
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      style='background-color:#faf9f2;'
    >
      <tr>
        <td style='padding:32px 16px;'>
          <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='max-width:680px;margin:0 auto;background-color:#ffffff;border:1px solid #d9dde4;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td style='padding:36px 32px;background-color:#7f1d1d;color:#fff7f7;'>
                <p
                  style='margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fee2e2;'
                >Don hang da huy</p>
                <h1 style='margin:0 0 12px;font-size:28px;line-height:1.25;'>Don hang #{{orderId}}
                  da bi huy</h1>
                <p style='margin:0;font-size:15px;line-height:1.7;color:#fff1f1;'>Xin chao
                  {{customerName}}, don hang cua ban da duoc huy vao
                  {{cancelledAt}}.</p>
              </td>
            </tr>
            <tr>
              <td style='padding:28px 32px;'>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  style='margin-bottom:24px;background-color:#fff7ed;border:1px solid #fed7aa;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:20px;'>
                      <p style='margin:0 0 14px;font-size:17px;font-weight:700;color:#182233;'>Tom
                        tat don hang</p>
                      <p
                        style='margin:0 0 8px;font-size:14px;line-height:1.6;color:#4c5968;'
                      ><strong style='color:#182233;'>Ma don hang:</strong> #{{orderId}}</p>
                      <p
                        style='margin:0 0 12px;font-size:14px;line-height:1.6;color:#4c5968;'
                      ><strong style='color:#182233;'>Thoi gian huy:</strong>
                        {{cancelledAt}}</p>
                      <p style='margin:0;font-size:15px;line-height:1.6;color:#182233;'><strong>Tong
                          thanh toan:</strong>
                        <span
                          style='font-size:22px;font-weight:700;color:#7f1d1d;'
                        >{{totalAmount}}</span></p>
                    </td>
                  </tr>
                </table>

                <h2 style='margin:0 0 14px;font-size:19px;line-height:1.3;color:#182233;'>San pham
                  trong don</h2>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  style='border-collapse:separate;border-spacing:0;border:1px solid #d9dde4;border-radius:8px;overflow:hidden;margin-bottom:24px;'
                >
                  <tr style='background-color:#efe6c8;color:#514118;'>
                    <th
                      align='left'
                      style='padding:12px 14px;font-size:12px;line-height:1.4;text-transform:uppercase;'
                    >San pham</th>
                    <th
                      align='right'
                      style='padding:12px 14px;font-size:12px;line-height:1.4;text-transform:uppercase;'
                    >So luong</th>
                    <th
                      align='right'
                      style='padding:12px 14px;font-size:12px;line-height:1.4;text-transform:uppercase;'
                    >Don gia</th>
                    <th
                      align='right'
                      style='padding:12px 14px;font-size:12px;line-height:1.4;text-transform:uppercase;'
                    >Thanh tien</th>
                  </tr>
                  {{#each items}}
                    <tr>
                      <td
                        style='padding:14px;border-top:1px solid #d9dde4;font-size:14px;line-height:1.6;color:#182233;'
                      ><strong>{{productName}}</strong></td>
                      <td
                        align='right'
                        style='padding:14px;border-top:1px solid #d9dde4;font-size:14px;line-height:1.6;color:#4c5968;'
                      >{{quantity}}</td>
                      <td
                        align='right'
                        style='padding:14px;border-top:1px solid #d9dde4;font-size:14px;line-height:1.6;color:#4c5968;'
                      >{{unitPrice}}</td>
                      <td
                        align='right'
                        style='padding:14px;border-top:1px solid #d9dde4;font-size:14px;line-height:1.6;font-weight:700;color:#182233;'
                      >{{lineTotal}}</td>
                    </tr>
                  {{/each}}
                </table>

                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  style='background-color:#f4f5f7;border:1px solid #d9dde4;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:18px 20px;'>
                      <p style='margin:0;font-size:13px;line-height:1.7;color:#4c5968;'>Day la email
                        tu dong tu he thong. Vui long khong tra loi truc tiep email nay.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>