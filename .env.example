# Server runtime
PORT=8000

# AWS / LocalStack
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_AUTH_TOKEN=

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:4566
PRODUCTS_TABLE=products
CATEGORIES_TABLE=categories
CARTS_TABLE=carts
CART_ITEMS_TABLE=cart-items
ORDERS_TABLE=orders
ORDER_ITEMS_TABLE=order-items
INVENTORY_TABLE=inventory
PLACE_ORDER_QUEUE_URL=http://localhost:4566/000000000000/place-order.fifo
PROCESS_PAYMENT_QUEUE_URL=http://localhost:4566/000000000000/process-payment.fifo
RELEASE_RESERVATION_QUEUE_URL=http://localhost:4566/000000000000/release-reservation.fifo
MOCK_PAYMENT_DELAY_MS=5000
MOCK_PAYMENT_FAILURE_RATE=0

# Cognito runtime
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDP_ENDPOINT=http://localhost.localstack.cloud:4566
COGNITO_DEFAULT_GROUP=customer

# Infra configuration
CLIENT_COGNITO_CALLBACK_URLS=http://localhost:3000/auth/callback
CLIENT_COGNITO_LOGOUT_URLS=http://localhost:3000/auth/login
CLIENT_CORS_ORIGINS=http://localhost:3000
COGNITO_DOMAIN_PREFIX=dynamodb-mvp-local

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Script helpers
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# CDK fallback account for local deploy
CDK_DEFAULT_ACCOUNT=000000000000
