# Server runtime
PORT=8000

# AWS / LocalStack
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_AUTH_TOKEN=

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:4566
PRODUCTS_TABLE=products
CATEGORIES_TABLE=categories
CARTS_TABLE=carts
CART_ITEMS_TABLE=cart-items
INVENTORY_TABLE=inventory
ORDERS_TABLE=orders
ORDER_ITEMS_TABLE=order-items

# SQS
SQS_ENDPOINT=http://localhost:4566
PLACE_ORDER_QUEUE_NAME=place-order.fifo
PLACE_ORDER_DLQ_NAME=place-order-dlq.fifo
PLACE_ORDER_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/place-order.fifo
PROCESS_PAYMENT_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/process-payment.fifo

# Cognito runtime
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDP_ENDPOINT=http://localhost.localstack.cloud:4566
COGNITO_DEFAULT_GROUP=customer
LOCALSTACK_COGNITO_BASE_URL=http://localhost.localstack.cloud:4566
COGNITO_IDP_LAMBDA_ENDPOINT=http://host.docker.internal:4566
ENABLE_LOCALSTACK_COGNITO_TRIGGERS=true
ENABLE_LOCALSTACK_API_GATEWAY_AUTHORIZER=true

# Infra configuration
CLIENT_COGNITO_CALLBACK_URLS=http://localhost:3000/auth/hosted-ui/callback
CLIENT_COGNITO_LOGOUT_URLS=http://localhost:3000/auth/login
CLIENT_CORS_ORIGINS=http://localhost:3000
COGNITO_DOMAIN_PREFIX=dynamodb-mvp-local
DYNAMODB_LAMBDA_ENDPOINT=http://host.docker.internal:4566
ORDERS_ENTITY_TYPE=ORDER
PAYMENT_CONFIRMATION_SECONDS_TIMEOUT=60
RESERVATION_EXPIRY_POLLER_SCHEDULE_MINUTES=1

# VNPay
VNPAY_TMN_CODE=TEST12345
VNPAY_SECURE_SECRET=SECRETKEY1234567890
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://<api-id>.execute-api.localhost.localstack.cloud:4566/payments/vnpay/return
VNPAY_IPN_URL=https://<api-id>.execute-api.localhost.localstack.cloud:4566/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_API_IP_ADDR=127.0.0.1

# Optional social login
GOOGLE_CLIENT_ID=123123
GOOGLE_CLIENT_SECRET=123123

# Script helpers
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# CDK fallback account for local deploy
CDK_DEFAULT_ACCOUNT=000000000000
