{
  "name": "dynamodb-ecommerce-learning",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS e-commerce MVP for learning DynamoDB with LocalStack",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "infra:synth": "cdklocal synth --app \"npx ts-node infra/bin/server-local.ts\"",
    "infra:bootstrap": "cdklocal bootstrap aws://000000000000/ap-southeast-1",
    "infra:deploy": "cdklocal deploy --app \"npx ts-node infra/bin/server-local.ts\" --require-approval never --method direct --outputs-file localstack-outputs.json && ts-node src/scripts/sync-localstack-env.ts",
    "infra:destroy": "cdklocal destroy --app \"npx ts-node infra/bin/server-local.ts\" --force",
    "infra:sync-env": "ts-node src/scripts/sync-localstack-env.ts",
    "db:setup": "ts-node src/scripts/setup-database.ts",
    "db:seed": "ts-node src/scripts/seed-database.ts",
    "users:create-admin": "ts-node src/scripts/create-admin-user.ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml}\""
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1107.0",
    "@aws-sdk/client-dynamodb": "^3.1107.0",
    "@aws-sdk/client-sqs": "^3.1107.0",
    "@aws-sdk/lib-dynamodb": "^3.1107.0",
    "@codegenie/serverless-express": "^4.17.1",
    "aws-jwt-verify": "^5.1.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1136.0",
    "aws-cdk-lib": "^2.264.0",
    "aws-cdk-local": "^3.0.4",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
