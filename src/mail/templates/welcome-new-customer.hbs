<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Chào mừng khách hàng mới</title>
  </head>
  <body
    style='margin:0;padding:0;background-color:#faf9f2;font-family:Arial,Helvetica,sans-serif;color:#182233;'
  >
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      style='background-color:#faf9f2;'
    >
      <tr>
        <td style='padding:32px 16px;'>
          <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='max-width:640px;margin:0 auto;background-color:#ffffff;border:1px solid #d9dde4;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td style='padding:36px 32px;background-color:#168078;color:#f4fffd;'>
                <p
                  style='margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#d9f7ef;'
                >Tài khoản đã sẵn sàng</p>
                <h1 style='margin:0 0 12px;font-size:28px;line-height:1.25;'>Chào mừng
                  {{customerName}}</h1>
                <p style='margin:0;font-size:15px;line-height:1.7;color:#ecfffb;'>Tài khoản của bạn
                  đã được tạo thành công. Bạn có thể đăng nhập và bắt đầu mua sắm ngay.</p>
              </td>
            </tr>
            <tr>
              <td style='padding:28px 32px;'>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  style='margin-bottom:22px;background-color:#f2f8f5;border:1px solid #d9eee6;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:20px;'>
                      <p style='margin:0 0 14px;font-size:17px;font-weight:700;color:#182233;'>Thông
                        tin tài khoản</p>
                      <p
                        style='margin:0 0 8px;font-size:14px;line-height:1.6;color:#4c5968;'
                      ><strong style='color:#182233;'>Tên đăng nhập:</strong> {{username}}</p>
                      <p style='margin:0;font-size:14px;line-height:1.6;color:#4c5968;'><strong
                          style='color:#182233;'
                        >Email:</strong>
                        {{email}}</p>
                    </td>
                  </tr>
                </table>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  style='background-color:#efe6c8;border:1px solid #e2d4aa;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:18px 20px;'>
                      <p style='margin:0;font-size:13px;line-height:1.7;color:#514118;'>Đây là email
                        tự động xác nhận tài khoản mới. Vui lòng không trả lời trực tiếp email này.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>