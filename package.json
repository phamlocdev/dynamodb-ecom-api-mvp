{
  "name": "dynamodb-ecommerce-learning",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS e-commerce MVP for learning DynamoDB with LocalStack",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:setup": "ts-node src/scripts/setup-database.ts",
    "db:seed": "ts-node src/scripts/seed-database.ts",
    "cdk:build:lambdas": "node scripts/build-lambdas.cjs",
    "cdk:synth": "npm run cdk:build:lambdas && cdk synth",
    "cdk:deploy:local": "npm run cdk:build:lambdas && npx aws-cdk-local deploy DynamodbLearningLambdasLocalStack --require-approval never --parameters ProductsTableName=products --parameters DynamoDbEndpoint=http://localhost.localstack.cloud:4566",
    "cdk:destroy:local": "npx aws-cdk-local destroy DynamodbLearningLambdasLocalStack --force",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml}\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1107.0",
    "@aws-sdk/lib-dynamodb": "^3.1107.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "aws-cdk": "2.176.0",
    "aws-cdk-local": "^2.0.7-alpha.0",
    "aws-cdk-lib": "2.176.0",
    "constructs": "^10.4.2",
    "prettier": "^3.9.6",
    "esbuild": "^0.25.9",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
