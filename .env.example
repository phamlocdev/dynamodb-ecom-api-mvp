# AWS development deployment. Copy to .env.dev and replace all placeholder values.
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
CDK_DEFAULT_ACCOUNT=123456789012
PORT=8000

# Physical resource names used only while CDK creates the resources.
# Lambda receives the resolved names from CDK resource props; do not duplicate them elsewhere.
PRODUCTS_TABLE=ecommerce-dev-products
CATEGORIES_TABLE=ecommerce-dev-categories
CARTS_TABLE=ecommerce-dev-carts
CART_ITEMS_TABLE=ecommerce-dev-cart-items
INVENTORY_TABLE=ecommerce-dev-inventory
ORDERS_TABLE=ecommerce-dev-orders
ORDER_ITEMS_TABLE=ecommerce-dev-order-items
EMAIL_TRACKING_TABLE=ecommerce-dev-email-tracking
EVENT_CONSUMER_IDEMPOTENCY_TABLE=ecommerce-dev-event-consumer-idempotency
USER_ACCOUNTS_TABLE=ecommerce-dev-user-accounts
USER_LOGIN_AUDIT_TABLE=ecommerce-dev-user-login-audit
PLACE_ORDER_QUEUE_NAME=ecommerce-dev-place-order.fifo
PLACE_ORDER_DLQ_NAME=ecommerce-dev-place-order-dlq.fifo
ORDER_EVENTS_BUS_NAME=ecommerce-dev-domain-events
MEDIA_BUCKET_NAME=replace-with-unique-ecommerce-dev-media
COGNITO_DOMAIN_PREFIX=replace-with-unique-ecommerce-dev
COGNITO_DEFAULT_GROUP=customer
COGNITO_DISPOSABLE_EMAIL_DOMAINS=10minutemail.com,mailinator.com,tempmail.com,temp-mail.org,guerrillamail.com,yopmail.com
CLIENT_CORS_ORIGINS=http://localhost:3000
CLIENT_COGNITO_CALLBACK_URLS=http://localhost:3000/auth/callback
CLIENT_COGNITO_LOGOUT_URLS=http://localhost:3000/auth/login
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET_NAME=ecommerce/dev/google-client-secret
PRODUCT_IMAGE_MAX_COUNT=10
MEDIA_READ_URL_TTL_SECONDS=900
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
ORDERS_ENTITY_TYPE=ORDER
PAYMENT_CONFIRMATION_SECONDS_TIMEOUT=300
RESERVATION_EXPIRY_POLLER_SCHEDULE_MINUTES=1
PLACE_ORDER_DELAY_MS=0

VNPAY_SECRET_NAME=ecommerce/dev/vnpay
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-api.execute-api.ap-southeast-1.amazonaws.com/payments/vnpay/return
VNPAY_IPN_URL=https://your-api.execute-api.ap-southeast-1.amazonaws.com/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_API_IP_ADDR=127.0.0.1
SES_ENABLED=false
SES_FROM_EMAIL=phamphuloc7663@gmail.com
SES_VERIFIED_RECIPIENTS=phamphuloc7663@gmail.com
SES_CONFIGURATION_SET_NAME=PhucLocEcommerceConfigurationSet
